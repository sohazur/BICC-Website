---
import { articles } from '../../seo/articles';
import { services } from '../../seo/services';
import { specialtyPages } from '../../seo/doctors';
const { lang = 'en' } = Astro.props;
const root = lang === 'bn' ? '/bn' : '';
---
<section class="discovery section-pad" aria-labelledby="discovery-title">
  <div class="shell">
    <div class="section-heading split">
      <div><p class="eyebrow">{lang === 'bn' ? 'সহজে উত্তর খুঁজুন' : 'Find a direct answer'}</p><h2 id="discovery-title">{lang === 'bn' ? 'লম্বা পৃষ্ঠা নয়—প্রয়োজন অনুযায়ী পথ।' : 'A shorter route to the right care.'}</h2></div>
      <p>{lang === 'bn' ? 'সেবা, বিশেষজ্ঞ বা ভিজিটের প্রস্তুতি—আলাদা পাতায় পরিষ্কার তথ্য দেখুন।' : 'Open a focused page for a service, specialist or visit question instead of searching through one long homepage.'}</p>
    </div>
    <div class="discovery-columns">
      <div><div class="column-heading"><span>01</span><h3>{lang === 'bn' ? 'ডায়াগনস্টিক ও ক্লিনিক' : 'Diagnostics & clinic'}</h3></div>{services.slice(0, 5).map((item) => <a class="answer-link" href={`${root}/services/${item.slug}`}><span>{item.title[lang]}</span><small>{item.answer[lang]}</small><b aria-hidden="true">→</b></a>)}<a class="view-all" href={`${root}/services`}>{lang === 'bn' ? 'সব সেবা দেখুন' : 'View all services'} →</a></div>
      <div><div class="column-heading"><span>02</span><h3>{lang === 'bn' ? 'বিশেষজ্ঞ খুঁজুন' : 'Find a specialist'}</h3></div>{specialtyPages.slice(0, 4).map((item) => <a class="answer-link" href={`${root}/specialists/${item.slug}`}><span>{item.title[lang]}</span><small>{item.intro[lang]}</small><b aria-hidden="true">→</b></a>)}<a class="view-all" href={`${root}/specialists`}>{lang === 'bn' ? 'সব বিশেষজ্ঞ বিভাগ' : 'All specialist areas'} →</a></div>
      <div><div class="column-heading"><span>03</span><h3>{lang === 'bn' ? 'ভিজিটের গাইড' : 'Patient guides'}</h3></div>{articles.slice(0, 4).map((item) => <a class="answer-link" href={`${root}/blog/${item.slug}`}><span>{item.title[lang]}</span><small>{item.dek[lang]}</small><b aria-hidden="true">→</b></a>)}<a class="view-all" href={`${root}/blog`}>{lang === 'bn' ? 'সব গাইড পড়ুন' : 'Read all guides'} →</a></div>
    </div>
  </div>
</section>

