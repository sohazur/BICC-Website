---
import { site, ui } from '../../seo/site';
const { lang = 'en' } = Astro.props;
const copy = ui[lang];
---
<nav class="seo-mobile-actions" aria-label={lang === 'bn' ? 'দ্রুত যোগাযোগ' : 'Quick patient actions'}>
  <a href={`tel:${site.phoneLink}`}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.56 2.81.69A2 2 0 0 1 22 16.9Z"/></svg>{copy.call}</a>
  <a href={site.whatsapp} target="_blank" rel="noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.8-1l-5.2 1.4 1.4-5A8.5 8.5 0 1 1 21 11.5Z"/></svg>{copy.whatsapp}</a>
  <a href={lang === 'bn' ? '/bn#contact' : '/#contact'}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M3 9h18M5 4h14a2 2 0 0 1 2 2v15H3V6a2 2 0 0 1 2-2Z"/></svg>{copy.appointment}</a>
  <a href={site.map} target="_blank" rel="noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>{copy.directions}</a>
</nav>

