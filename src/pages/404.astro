---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../seo/site';
---
<BaseLayout lang="en" path="/404" title="Page not found" description="The requested BICC page could not be found." noindex={true}>
  <section class="not-found"><div class="shell"><p class="eyebrow">404 · Page not found</p><h1>This route does not lead to a BICC page.</h1><p>Choose the service directory, return home, or call us if you need help now.</p><div class="hero-actions"><a class="button primary" href="/services">Find a service</a><a class="button secondary" href="/">Go home</a><a class="text-link" href={`tel:${site.phoneLink}`}>Call {site.phoneDisplay}</a></div><p lang="bn">পাতাটি পাওয়া যায়নি। <a href="/bn">বাংলা হোমপেজে যান</a> অথবা BICC-তে কল করুন।</p></div></section>
</BaseLayout>

