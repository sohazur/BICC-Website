---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/astro/PageHero.astro';
import { breadcrumbSchema, entityGraph } from '../../seo/schema';
import { site } from '../../seo/site';
const path = '/bn/about';
const crumbs = [{ label: 'হোম', href: '/bn' }, { label: 'পরিচিতি ও সম্পাদকীয় নীতি', href: path }];
---
<BaseLayout lang="bn" path={path} title="BICC পরিচিতি ও সম্পাদকীয় নীতি" description="BICC কী তথ্য প্রকাশ করে, সেবা ও ডাক্তার তথ্য কীভাবে পর্যালোচনা হয়, কোন তথ্য ফোনে নিশ্চিত করতে হয় এবং সংশোধন কীভাবে জানাবেন—দেখুন।" schemas={[entityGraph, breadcrumbSchema(crumbs)]}>
  <PageHero lang="bn" eyebrow="BICC পরিচিতি" title="স্থানীয় তথ্য, পরিষ্কার সীমা, প্রয়োজনীয় উত্তর" answer="বিশ্বাস ইনভেস্টিগেশন সেন্টার ও ক্লিনিক সোনাডাঙ্গা, খুলনায় রোগীদের সেবা দেয়। এই ওয়েবসাইটে প্রতিষ্ঠান-প্রদত্ত তথ্য ও বাইরের চিকিৎসা উৎস আলাদা রাখা হয় এবং কোন তথ্য ফোনে নিশ্চিত করতে হবে তা বলা হয়।" aliases={['বিশ্বাস ক্লিনিক', 'বিশ্বাস ইনভেস্টিগেশন সেন্টার', 'BICC খুলনা']} />
  <section class="editorial section-pad"><div class="shell editorial-grid"><article><h2>যে তথ্য আমরা যাচাই করতে পারি</h2><p>BICC-এর প্রতিষ্ঠান-প্রদত্ত তথ্য অনুযায়ী প্রতিষ্ঠানটি ৯ সেপ্টেম্বর ১৯৯৮ সালে যাত্রা শুরু করে এবং ঠিকানা সোনাডাঙ্গায় খুলনা মেডিকেল কলেজ হাসপাতালের পূর্ব পাশে EX-2। বর্তমান ওয়েবসাইটে BICC-প্রদত্ত ১৫৬টি পরীক্ষার নাম ও ৬০ জন ডাক্তারের দ্বিভাষিক তথ্য আছে।</p><p>বাংলাদেশের DGHS Facility Registry-তে সোনাডাঙ্গা, খুলনার <strong>বিশ্বাস ক্লিনিক</strong> 10032812 কোডে Private Hospital / Clinic এবং আলাদাভাবে <strong>বিশ্বাস ইনভেস্টিগেশন সেন্টার</strong> 10033032 কোডে Consultancy & Diagnostic Center হিসেবে তালিকাভুক্ত। এই তালিকাকে ওয়েবসাইটে অতিরিক্ত স্বীকৃতির দাবি হিসেবে দেখানো হয়নি।</p><div class="source-links"><a href="https://facilityregistry.dghs.gov.bd/public/facility-registry/reports/organization-list?alias_columns_csv=Id%2CName%2CName+%28Bangla%29%2CCode%2CEmail%2CAgency%2CType%2CDivision%2CDistrict%2CCity+Corporation%2CUpazila%2CPaurasava%2CUnion%2CPrivate&columns_csv=id%2Cname%2Cname_bn%2Ccode%2Cemail_1%2Cfacility_agency_name%2Cfacility_type_name%2Cdivision_name%2Cdistrict_name%2Ccity_corporation_name%2Cupazila_name%2Cpaurasava_name%2Cunion_name%2Cis_private&is_active=1&page=626&submit=Run" target="_blank" rel="noreferrer">DGHS: বিশ্বাস ক্লিনিক ↗</a><a href="https://facilityregistry.dghs.gov.bd/public/facility-registry/reports/organization-list?alias_columns_csv=Id%2CName%2CName+%28Bangla%29%2CCode%2CEmail%2CAgency%2CType%2CDivision%2CDistrict%2CCity+Corporation%2CUpazila%2CPaurasava%2CUnion%2CPrivate&columns_csv=id%2Cname%2Cname_bn%2Ccode%2Cemail_1%2Cfacility_agency_name%2Cfacility_type_name%2Cdivision_name%2Cdistrict_name%2Ccity_corporation_name%2Cupazila_name%2Cpaurasava_name%2Cunion_name%2Cis_private&is_active=1&page=630&submit=Run" target="_blank" rel="noreferrer">DGHS: বিশ্বাস ইনভেস্টিগেশন সেন্টার ↗</a></div></article><article><h2>তথ্য কীভাবে পর্যালোচনা হয়</h2><ul class="policy-list"><li><strong>প্রতিষ্ঠানের তথ্য:</strong> পরীক্ষার নাম, ডাক্তার তালিকা, সেবা, যোগাযোগ ও ঠিকানা BICC-এর উপকরণ থেকে আসে।</li><li><strong>বাইরের তথ্য:</strong> চিকিৎসা নিরাপত্তার সাধারণ তথ্য NHS, MedlinePlus ও RadiologyInfo-এর মতো উৎসের লিংকসহ দেওয়া হয়।</li><li><strong>অপ্রকাশিত তথ্য:</strong> মূল্য, প্রস্তুতি, সময়সূচি, রিপোর্টের সময়, কেবিন সংখ্যা, খালি থাকা বা ফলাফল অনুমান করা হয় না।</li><li><strong>তুলনা:</strong> “সেরা ক্লিনিক” প্রশ্নের উত্তর নিরপেক্ষ চেকলিস্টে দেওয়া হয়—নিজেদের সেরা দাবি বা প্রতিদ্বন্দ্বীকে খাটো করা হয় না।</li><li><strong>ভাষা:</strong> ইংরেজি ও বাংলা পাতার আলাদা crawlable URL এবং একই তথ্যগত সীমা আছে।</li></ul></article><article><h2>সংশোধন ও আপডেট</h2><p>তথ্য সর্বশেষ ১৬ আগস্ট ২০২৬ পর্যালোচনা করা হয়েছে। ডাক্তার, সেবা, যোগাযোগ বা অন্য তথ্য ভুল হলে <a href={`tel:${site.phoneLink}`}>{site.phoneDisplay}</a> নম্বরে কল করুন বা <a href={site.whatsapp} target="_blank" rel="noreferrer">WhatsApp-এ</a> জানান। উৎস যাচাই করে ওয়েবসাইট বদলানো উচিত।</p><p>এটি সেবা খোঁজা ও ভিজিটের তথ্য দেয়, চিকিৎসা পরামর্শ বা জরুরি triage নয়। জীবন-ঝুঁকিপূর্ণ জরুরি অবস্থায় বাংলাদেশে ৯৯৯-এ কল করুন।</p></article></div></section>
</BaseLayout>

