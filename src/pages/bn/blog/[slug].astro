---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import ActionRail from '../../../components/astro/ActionRail.astro';
import { articles } from '../../../seo/articles';
import { services } from '../../../seo/services';
import { articleSchema, breadcrumbSchema, entityGraph } from '../../../seo/schema';
import { formatReviewDate, ui } from '../../../seo/site';
export function getStaticPaths() { return articles.map((article) => ({ params: { slug: article.slug }, props: { article } })); }
const { article } = Astro.props;
const path = `/bn/blog/${article.slug}`;
const crumbs = [{ label: 'হোম', href: '/bn' }, { label: 'রোগী নির্দেশিকা', href: '/bn/blog' }, { label: article.title.bn, href: path }];
---
<BaseLayout lang="bn" path={path} title={article.title.bn} description={article.meta.bn} pageType="article" schemas={[entityGraph, breadcrumbSchema(crumbs), articleSchema({ title: article.title.bn, description: article.meta.bn, path, lang: 'bn' })]}>
  <Breadcrumbs items={crumbs} lang="bn" />
  <article class="article-page">
    <header class="article-header shell"><p class="eyebrow">রোগী গাইড · খুলনা</p><h1>{article.title.bn}</h1><p class="article-dek">{article.dek.bn}</p><div class="article-byline"><span>BICC সম্পাদকীয় দল</span><span>{article.readMinutes} মিনিটের পাঠ</span><span>পর্যালোচনা {formatReviewDate('bn')}</span></div><div class="direct-answer"><span>সরাসরি উত্তর</span><p>{article.answer.bn}</p></div></header>
    <div class="shell article-layout"><div class="article-body"><h2>{article.slug.includes('best-clinic') ? 'তুলনার ১০টি বিষয়' : 'আপনার ব্যবহারিক চেকলিস্ট'}</h2><ol class="article-steps">{article.items.bn.map(([title, text], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>{article.sources?.length && <section class="article-sources"><h2>{ui.bn.sources}</h2><p>উৎসগুলো সাধারণ চিকিৎসা তথ্য সমর্থন করে। BICC-এর নিজস্ব তালিকা প্রতিষ্ঠান-প্রদত্ত।</p><ul>{article.sources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a></li>)}</ul></section>}<aside class="medical-disclaimer"><strong>গুরুত্বপূর্ণ</strong><p>{ui.bn.disclaimer}</p></aside><section class="related-block"><p class="eyebrow">সম্পর্কিত BICC সেবা</p><h2>তথ্য থেকে পরবর্তী পদক্ষেপ</h2><div class="mini-grid">{services.slice(0, 3).map((service) => <a href={`/bn/services/${service.slug}`}><strong>{service.title.bn}</strong><span>{service.answer.bn}</span></a>)}</div></section></div><ActionRail lang="bn" answer={article.answer.bn} fact="BICC সোনাডাঙ্গা, খুলনার জন্য প্রতিষ্ঠান-প্রদত্ত সেবা ও ডাক্তার তালিকা প্রকাশ করে।" confirm="মূল্য, প্রস্তুতি, বর্তমান সময়সূচি, প্রাপ্যতা ও রিপোর্টের সময়।" /></div>
  </article>
</BaseLayout>

